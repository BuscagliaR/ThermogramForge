{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ThermogramForge",
  "version": "2.0.0-spike",
  "identifier": "edu.nau.thermogramforge",
  "build": {
    "frontendDist": "../../../spike/site",
    "devUrl": "http://localhost:8008"
  },
  "app": {
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
